# ==========================================
# 🤖 CONFIGURAÇÕES DO AGOTA DE IDEIAS
# ==========================================

# 1. Token do Bot do Telegram (Obtido via @BotFather)
TELEGRAM_BOT_TOKEN="SEU_TOKEN_TELEGRAM_AQUI"

# 2. Chave de API do Google Gemini (Obtido em https://aistudio.google.com/)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"
GEMINI_MODEL="gemini-3.5-flash"

# 3. Expressão do Cron Job de Cobrança
# Padrão: '0 * * * *' (a cada hora no minuto zero)
# Para testar a cada 5 minutos: '*/5 * * * *'
# Para testar a cada minuto: '* * * * *'
CRON_SCHEDULE="0 * * * *"

# 4. Credenciais do Firebase Firestore
# Opção A: Caminho para o arquivo JSON da conta de serviço (recomendado)
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# Opção B: Conteúdo JSON da conta de serviço em uma única linha (para deploy em containers / nuvem)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# ID do Projeto Firebase (opcional se contido no JSON da conta de serviço)
FIREBASE_PROJECT_ID="seu-projeto-firebase"

NODE_ENV="development"
